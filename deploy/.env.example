# Copy to deploy/.env; keep real values outside Git.
WANFO_DB_NAME=wanfo_bi
WANFO_DB_USER=wanfo
WANFO_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
WANFO_REDIS_PASSWORD=
# Prometheus and Spring Boot Admin actuator authentication; generated by init-local.ps1.
WANFO_ACTUATOR_USERNAME=wanfo-prometheus
WANFO_ACTUATOR_PASSWORD=
# Base64 of at least 64 random bytes; identical across all backend services.
WANFO_JWT_SECRET=
WANFO_MYSQL_PORT=13306
WANFO_REDIS_PORT=16379

# OpenTelemetry tracing (opt-in for local development).
WANFO_TRACING_ENABLED=false
WANFO_OTEL_AGENT_VERSION=2.33.0
WANFO_OTEL_SAMPLE_PROBABILITY=1.0
WANFO_GRAFANA_ADMIN_USER=admin
WANFO_GRAFANA_ADMIN_PASSWORD=
