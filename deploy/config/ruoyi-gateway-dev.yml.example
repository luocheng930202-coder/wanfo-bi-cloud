spring:
  cloud:
    gateway:
      server:
        webflux:
          discovery:
            locator:
              enabled: false
          routes:
            - id: wanfo-auth
              uri: ${WANFO_AUTH_URL:http://127.0.0.1:9200}
              predicates:
                - Path=/auth/**
              filters:
                - StripPrefix=1
            - id: wanfo-system
              uri: ${WANFO_SYSTEM_URL:http://127.0.0.1:9201}
              predicates:
                - Path=/system/**
              filters:
                - StripPrefix=1
            - id: wanfo-bi
              uri: ${WANFO_BI_URL:http://127.0.0.1:9206}
              predicates:
                - Path=/bi/**
            - id: wanfo-file
              uri: ${WANFO_FILE_URL:http://127.0.0.1:9300}
              predicates:
                - Path=/file/**
              filters:
                - StripPrefix=1
